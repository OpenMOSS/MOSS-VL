# ============ shell / deploy layer (demo.sh + run_*.sh) ============
#export WEB_PORT=        # vite preview port (the ONE port to expose; default 20941)
#export PORT=        # backend api port (loopback only; default 8000)
#export PI_PORT=        # local pi-agent port; MEMORY_PI_URL defaults to this port (default 38082)
#export LOG_ROOT=        # in-repo log tree root (default <repo>/logs)
#export PYBIN=        # API/rotating_tee interpreter (default <repo>/.venv/bin/python)
#export FFMPEG_LIBS=        # vendored FFmpeg .so dir for torchcodec (default <repo>/.venv/lib/ffmpeg)
#export BUILD_LOG=        # vite build-watcher log (default <repo>/logs/stdout/web/build.log)
#export API_WAIT_S=        # demo.sh api health-gate budget (default 600)
#export VLM_WAIT_S=        # demo.sh VLM-loaded wait budget (default 480)
#export DEMO_SESSION=        # tmux session name (default moss)
#export DEMO_SKIP_GPU=        # 1 = CPU-only bring-up (frontend work; VLM won't load)
#export TTS_PORT=        # demo.sh down: first TTS sidecar port to sweep (default 18100)
#export UVICORN_LOOP=        # uvicorn event loop (default uvloop)
#export WS_MAX_SIZE=        # WebSocket transport limit in bytes (default twice GATEWAY_MAX_FRAME_BYTES)
#export WS_PING_INTERVAL=        # WebSocket ping interval in seconds (default 20)
#export WS_PING_TIMEOUT=        # WebSocket ping timeout in seconds (default 20)
#export WATCH_POLL=        # 1 = polling vite build watcher (load-bearing on shared FS)
#export WEB_NVM_NODE=        # machine-dependent nvm version/alias for the web window (run_web.sh); set on boxes whose system Node is too old for Vite (Blackwell: 22); unset = no-op
#export VITE_BACKEND_ORIGIN=        # explicit vite /api proxy URL; otherwise derived from PORT (default http://127.0.0.1:8000)
#export GPU=        # standalone worker: CUDA_VISIBLE_DEVICES value
#export WORKER_ID=        # standalone worker: worker id
