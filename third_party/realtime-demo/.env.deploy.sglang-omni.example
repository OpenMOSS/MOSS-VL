# Minimal video/text Demo using an already-running external realtime backend.
# Copy to .env.deploy only on a fresh setup; merge into existing config otherwise.
# This file is parsed as literal KEY=VALUE, not sourced: no $VAR expansion.
VLM_DEPLOY=sglang_omni
SGLANG_OMNI_URLS=http://127.0.0.1:18500
SGLANG_OMNI_SESSIONS_PER_REPLICA=1
SGLANG_OMNI_CONTEXT_LENGTH=131072
SGLANG_OMNI_CONTEXT_RESERVE_TOKENS=4096
SGLANG_OMNI_FALLBACK_FRAME_TOKENS=2048
SGLANG_OMNI_INPUT_QUEUE_CAPACITY=4
MODEL_PATH=/path/to/moss-vl-realtime-sglang
AUTOLOAD_VLM=1
GEN_MAX_TOKENS_PER_TURN=4
OFFLINE_PROVIDER=none
ASR_ENABLED=0
TTS_ENABLED=0
TTS_SPAWN=0
MEMORY_ENABLED=0
GATEWAY_CREATE_TIMEOUT_S=30
GATEWAY_MAX_FRAME_BYTES=33554432
WS_MAX_SIZE=67108864
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
# Set to the real model/backend release identifier before external delivery.
GATEWAY_MODEL_VERSION=
PORT=8000
WEB_PORT=20941
# VITE_BACKEND_ORIGIN is derived from PORT; set only for a separate API host.
